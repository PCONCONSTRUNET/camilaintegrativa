# Conexão Banco de Dados PostgreSQL (Supabase Pooler IPv4 & IPv6)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[SENHA]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Credenciais do Projeto Supabase
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Autenticação administrativa da aplicação
CLINICA_AUTH_SECRET=gere-uma-chave-longa-e-aleatoria
CLINICA_ADMIN_EMAIL=administracao@seudominio.com.br
CLINICA_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Opcional para desenvolvimento puramente local offline (fallback SQLite)
# CLINICA_DATABASE_PATH=.data/clinica.sqlite
# CLINICA_ENABLE_DEMO_SEED=0

# Notificações Push Web & PWA (OneSignal)
NEXT_PUBLIC_ONESIGNAL_APP_ID=d1a83484-dce6-45f0-880f-15f3d8235d4c
NEXT_PUBLIC_ONESIGNAL_SAFARI_WEB_ID=web.onesignal.auto.4b51c712-23a7-447d-a673-6f24b07d407b
ONESIGNAL_REST_API_KEY=sua_chave_api_rest_aqui


