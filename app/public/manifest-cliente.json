{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/cliente",
  "name": "Portal do Paciente | Camila Machado",
  "short_name": "Meu Portal",
  "description": "Seus agendamentos, sessões, prontuário e acompanhamento terapêutico.",
  "start_url": "/cliente",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#FFFFFF",
  "theme_color": "#245D80",
  "categories": ["medical", "health", "lifestyle"],
  "lang": "pt-BR",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Minhas Sessões",
      "short_name": "Sessões",
      "description": "Ver meus agendamentos e histórico",
      "url": "/cliente?tab=sessoes",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Agendar Nova Sessão",
      "short_name": "Agendar",
      "description": "Escolher horário ou sessão coletiva",
      "url": "/agendar",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Faturas & Pagamentos",
      "short_name": "Faturas",
      "description": "Ver pagamentos e comprovantes",
      "url": "/cliente?tab=faturas",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Meu Perfil",
      "short_name": "Perfil",
      "description": "Dados cadastrais e notificações",
      "url": "/cliente?tab=perfil",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}

