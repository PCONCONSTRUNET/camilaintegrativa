{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/admin",
  "name": "Admin Camila",
  "short_name": "Admin Camila",
  "description": "Gestão de agenda, prontuários, financeiro e pacientes.",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#FFFFFF",
  "theme_color": "#182B38",
  "categories": ["medical", "health", "business"],
  "lang": "pt-BR",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Agenda do Dia",
      "short_name": "Agenda",
      "description": "Ver compromissos e horários de hoje",
      "url": "/admin/agenda",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Pacientes",
      "short_name": "Pacientes",
      "description": "Cadastro de clientes e prontuários",
      "url": "/admin/clientes",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Financeiro",
      "short_name": "Financeiro",
      "description": "Fluxo de caixa e cobranças",
      "url": "/admin/financeiro",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Auditoria & LGPD",
      "short_name": "Auditoria",
      "description": "Logs de segurança e consentimentos",
      "url": "/admin/auditoria",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
}

